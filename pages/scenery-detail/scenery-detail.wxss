/* 风光设施详情样式 */

.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 顶部大图 */
.detail-image {
  width: 100%;
  height: 400rpx;
}

/* 信息区域 */
.detail-info {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -30rpx;
  padding: 40rpx 30rpx;
  position: relative;
}

/* 名称和状态 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

/* 状态标签 */
.tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tag-open {
  background-color: #e8f5e9;
  color: #4caf50;
}

.tag-close {
  background-color: #ffebee;
  color: #f44336;
}

/* 信息行 */
.info-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.info-value.highlight {
  color: #1a73e8;
  font-weight: 500;
}

/* 描述 */
.detail-desc {
  margin: 24rpx 0;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-desc text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 注意事项 */
.notice-box {
  background-color: #fff8e1;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #e65100;
  display: block;
  margin-bottom: 8rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #bf360c;
  line-height: 1.6;
}
