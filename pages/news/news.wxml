<!-- 新闻列表页 - 成员A负责 -->
<view class="container">
  <view class="news-list">
    <view class="news-item" wx:for="{{newsList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="news-image" src="{{item.image}}" mode="aspectFill"/>
      <view class="news-content">
        <view class="news-title">{{item.title}}</view>
        <view class="news-meta">
          <text class="news-time">{{item.time}}</text>
          <text class="news-views">👁 {{item.views}}</text>
        </view>
        <view class="news-summary">{{item.summary}}</view>
      </view>
    </view>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更多</view>
  <view class="no-more" wx:else>没有更多了</view>
</view>
