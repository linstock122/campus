/* 图片预览页样式 */
.preview-container {
  width: 100vw;
  height: 100vh;
  background-color: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.swiper {
  width: 100%;
  height: 100%;
}

.swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.indicator {
  position: fixed;
  top: 40rpx;
  right: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  z-index: 10;
}

.name-label {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  z-index: 10;
}
