/* 新闻详情样式 - 成员A负责 */
.container {
  padding: 30rpx;
  background: #fff;
  min-height: 100vh;
}

.news-header {
  margin-bottom: 30rpx;
}

.news-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.news-meta {
  display: flex;
  font-size: 26rpx;
  color: #999;
}

.news-time {
  margin-right: 30rpx;
}

.news-image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.news-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 40rpx;
}

.news-content p {
  margin-bottom: 20rpx;
}

.news-footer {
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
