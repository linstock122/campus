/* 风光设施样式 - 成员B负责 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx;
}

.scenery-item {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.scenery-item.closed {
  opacity: 0.6;
}

.scenery-item image {
  width: 100%;
  height: 200rpx;
}

.scenery-info {
  padding: 16rpx;
}

.scenery-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.scenery-status {
  margin-bottom: 8rpx;
}

.scenery-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}
