/* 首页样式 - 成员A负责 */
.swiper {
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.swiper image {
  width: 100%;
  height: 100%;
}

.school-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.school-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 20rpx;
}

.school-info {
  flex: 1;
}

.nav-grid {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-item image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.nav-item text {
  font-size: 24rpx;
  color: #666;
}
