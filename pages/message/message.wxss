/* 留言页样式 - 成员C负责 */
.message-list {
  margin-top: 20rpx;
}

.message-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.message-item:last-child {
  border-bottom: none;
}

.message-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.message-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.message-time {
  font-size: 24rpx;
  color: #999;
}

.message-location {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.message-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  background: #f5f5f5;
  padding: 16rpx;
  border-radius: 8rpx;
}
