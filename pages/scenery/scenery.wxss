/* 风光设施页样式 - Flex布局 */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 分区标题 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 10rpx;
  border-left: 6rpx solid #1AAD19;
  margin-bottom: 16rpx;
}

/* Flex图片网格 - 每行两列 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 每个网格项 */
.grid-item {
  width: 48%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

/* 设施关闭状态 */
.facility-item.closed {
  opacity: 0.5;
}

/* 图片 */
.grid-item image {
  width: 100%;
  height: 220rpx;
}

/* 信息区域 */
.item-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

/* 名称 */
.item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 描述 */
.item-desc {
  font-size: 22rpx;
  color: #888;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 设施头部（名称+状态标签） */
.facility-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.facility-header .item-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 10rpx;
}

/* 开放状态标签 */
.tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.tag-open {
  background-color: #e8f5e9;
  color: #4caf50;
}

.tag-close {
  background-color: #ffebee;
  color: #f44336;
}

/* 开放时间 */
.item-time {
  font-size: 20rpx;
  color: #1a73e8;
}
