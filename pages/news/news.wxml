<!-- 新闻列表页 - 成员A负责 -->
<import src="/templates/news-item.wxml"/>

<view class="container">
  <view class="news-list">
    <template is="newsItem" wx:for="{{displayList}}" wx:key="id" data="{{...item}}"/>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !isLoading}}" bindtap="loadMore">
    <text>点击加载更多</text>
  </view>
  <view class="loading" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && displayList.length > 0}}">
    <text>— 没有更多了 —</text>
  </view>
  <view class="empty" wx:if="{{displayList.length === 0 && !isLoading}}">
    <text>暂无新闻</text>
  </view>
</view>
