/* 首页样式 - 成员A负责 */

/* 轮播图 */
.swiper {
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.swiper image {
  width: 100%;
  height: 100%;
}

.swiper-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
  color: #fff;
  padding: 30rpx 20rpx 20rpx;
  font-size: 32rpx;
}

/* 学校卡片 */
.school-card {
  padding: 30rpx;
}

.school-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.school-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
  border: 2rpx solid #1AAD19;
}

.school-info {
  flex: 1;
}

.school-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.school-motto {
  font-size: 26rpx;
  color: #1AAD19;
  font-style: italic;
}

.school-intro {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 导航卡片 */
.nav-card {
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1AAD19;
}

.nav-grid {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  width: 25%;
}

.nav-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
}

.nav-name {
  font-size: 26rpx;
  color: #666;
}

/* 详情卡片 */
.detail-card {
  padding: 30rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.detail-content p {
  margin-bottom: 16rpx;
}
