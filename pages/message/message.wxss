/* 留言页样式 - 成员C负责 */

/* 表单卡片 */
.form-card {
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1AAD19;
}

.section-title .count {
  font-size: 26rpx;
  color: #999;
  font-weight: normal;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input, .form-textarea {
  width: 100%;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f9f9f9;
}

.form-input {
  height: 80rpx;
}

.form-textarea {
  height: 200rpx;
}

.submit-btn {
  margin-top: 20rpx;
  background: #1AAD19;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.submit-btn:active {
  opacity: 0.8;
}

/* 留言列表 */
.list-card {
  padding: 30rpx;
}

.message-list {
  margin-top: 20rpx;
}

.message-item {
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.message-user {
  flex: 1;
}

.message-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.message-location {
  font-size: 24rpx;
  color: #999;
}

.message-actions {
  text-align: right;
}

.message-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.delete-btn {
  font-size: 24rpx;
  color: #ff4d4f;
}

.delete-btn:active {
  opacity: 0.7;
}

.message-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.clear-btn {
  text-align: center;
  padding: 20rpx;
  margin-top: 20rpx;
  color: #999;
  font-size: 26rpx;
}

.clear-btn:active {
  color: #ff4d4f;
}

/* 空状态 */
.empty-card {
  padding: 60rpx 30rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 小组介绍 */
.team-card {
  padding: 30rpx;
}

.team-card rich-text {
  font-size: 28rpx;
  line-height: 1.8;
}
