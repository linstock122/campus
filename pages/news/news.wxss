/* 新闻列表样式 - 成员A负责 */
@import '/templates/news-item.wxss';

.container {
  padding: 20rpx;
}

.news-list {
  min-height: 100vh;
}

.load-more, .loading, .no-more, .empty {
  text-align: center;
  padding: 40rpx;
  font-size: 28rpx;
  color: #999;
}

.load-more {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.load-more:active {
  background: #f5f5f5;
}
