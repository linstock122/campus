/* 校园地图页样式 */

.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 校区切换 */
.campus-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx;
  gap: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  background: #f0f0f0;
}

.tab-active {
  background: #1AAD19;
  color: #fff;
  font-weight: bold;
}

/* 地图 */
.map {
  width: 100%;
  height: 500rpx;
}

/* 校区信息 */
.campus-info {
  padding: 20rpx;
}

.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.nav-btn {
  background: #1AAD19;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.info-address {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.info-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}
